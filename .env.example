# Токен пользователя ВК (User Token), полученный через VK Host или OAuth.
# Нужен scope: messages
# Важно: один токен = одна сессия. Не запускай бота в двух окнах и не перевыпускай
# токен каждый раз — VK может забанить за «многократный вход».
VK_USER_TOKEN=vk1.a.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Второй аккаунт (необязательно — бот слушает оба одновременно)
# VK_USER_TOKEN_2=vk1.a.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# WAQI / AQICN — погода и качество воздуха: https://aqicn.org/api/
# Токен: https://aqicn.org/data-platform/token/
# WAQI_TOKEN=

# LONGPOLL_PRELOAD=1

# --- OpenRouter (предпочтительно для Claude Sonnet) ---
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
AI_PROVIDER=openrouter
AI_BASE_URL=https://openrouter.ai/api/v1
# Sonnet 4.7 на OpenRouter пока нет; актуальная Sonnet-модель — 4.6
AI_MODEL=anthropic/claude-sonnet-4.6

# --- BotHub (запасной вариант, если нет OpenRouter) ---
# BOTHUB_API_KEY=your_bothub_api_key_here
# AI_PROVIDER=bothub
# AI_BASE_URL=https://bothub.chat/api/v2/openai/v1
# Текст (дешевле):
# AI_MODEL=deepseek-chat
# Фото и видео (качественнее):
# AI_VISION_MODEL=claude-sonnet-4.6
# Смена моделей в чате (только владелец): /ии, /ии список, /ии текст MODEL, /ии фото MODEL
# Сохраняется в ai_models.json (перезапуск не сбрасывает)
# Модель Whisper для расшифровки речи из видео (OpenAI-compatible /audio/transcriptions)
# AI_WHISPER_MODEL=whisper-1
# Озвучка ответа: «артем озвучь …» (BotHub TTS, при 401 — edge-tts)
# AI_TTS_MODEL=tts-1-1106
# AI_TTS_VOICE=onyx   # стартовый голос; дальше /голос дмитрий и т.д.
# AI_TTS_BASE_URL=https://openai.bothub.chat/v1
# Расшифровка видео: auto (только если спросили про речь), always, never
# TRANSCRIBE_VIDEO=auto
# Лимит длины ответа ИИ (короче = быстрее)
# AI_MAX_TOKENS=2000
# CHAT_CONTEXT_MESSAGES=20

# Системный промпт (необязательно — по умолчанию бот «Артём, злой и пошлый без жёсткого мата»)
# AI_SYSTEM_PROMPT=...
